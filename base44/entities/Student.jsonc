{
  "name": "Student",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "village_code": {
      "type": "string"
    },
    "home_stop_code": {
      "type": "string"
    },
    "college": {
      "type": "string"
    },
    "pass_code": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "exam_time": {
      "type": "string"
    },
    "exam_subject": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}