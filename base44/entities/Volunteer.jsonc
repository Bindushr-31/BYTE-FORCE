{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "village_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_area": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "pending",
        "suspended"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ]
    },
    "open_tasks": {
      "type": "number"
    },
    "last_report_at": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}